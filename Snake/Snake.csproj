<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Snake</AssemblyName>
    <RootNamespace>Snake</RootNamespace>
    <ApplicationIcon>Slike\icon.ico</ApplicationIcon>
    <Product>Blavor</Product>
    <Version>2.0.0</Version>
    <Copyright>Copyright © 2025 Pero Grubač</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Leftovers from the .NET Framework project template, not used by the game. -->
    <Compile Remove="Properties\Resources.Designer.cs;Properties\Settings.Designer.cs" />
    <EmbeddedResource Remove="Properties\Resources.resx" />
    <None Remove="App.config;Properties\Settings.settings" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Slike\Body.png" />
    <Resource Include="Slike\DeadBody.png" />
    <Resource Include="Slike\DeadHead.png" />
    <Resource Include="Slike\Empty.png" />
    <Resource Include="Slike\Food.png" />
    <Resource Include="Slike\Head.png" />
    <Resource Include="Slike\icon.ico" />
    <Resource Include="Slike\DroidSansMono.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Snake.Core\Snake.Core.csproj" />
  </ItemGroup>

</Project>
